{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tallier",
  "version": "0.1.0",
  "identifier": "com.paracosmos.tallier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Tallier",
      "width": 400,
      "height": 250,
      "minHeight": 250,
      "minWidth": 400,
      "resizable": false,
      "fullscreen": false,
      "alwaysOnTop": false,
      "maximizable": true,
      "transparent": true,
      "decorations": false,
      "shadow": false
    }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/avatars/*"]
      }
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "publisher": "Paracosmos Studio",
    "category": "Utilities",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0Q0ZGNTE4MUVDMzYxMzkKUldRNVljTWVHUFhQOUR6Z0VSalJDRU5rVSs4cFF0bmZ1VVVqa21CdUFMaHZxaW5YeFE1dkNFVUcK",
      "endpoints": [
        "https://github.com/paracosmos-studio/tallier/releases/latest/download/latest.json"
      ]
    }
  }
}
