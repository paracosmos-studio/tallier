{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tally",
  "version": "0.1.0",
  "identifier": "com.paracosmos.tally",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Tally",
      "width": 400,
      "height": 250,
      "minHeight": 250,
      "minWidth": 400,
      "maxHeight": 400,
      "maxWidth": 400,
      "resizable": true,
      "fullscreen": false,
      "alwaysOnTop": true,
      "maximizable": true,
      "transparent": true,
      "decorations": false,
      "shadow": false
    }],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
