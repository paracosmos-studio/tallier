{
  "name": "tallier",
  "version": "0.3.0",
  "description": "track time across multiple projects",
  "author": {
    "name": "Paracosmos Studio Inc.",
    "url": "https://paracosmos.studio"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "tauri:build:appstore": "tauri build --target universal-apple-darwin --config src-tauri/tauri.appstore.conf.json -- --no-default-features",
    "tauri:pkg:appstore": "xcrun productbuild --sign '3rd Party Mac Developer Installer: Paracosmos Studio Inc. (DH55V4KQGD)' --component src-tauri/target/universal-apple-darwin/release/bundle/macos/Tallier.app /Applications src-tauri/target/Tallier.pkg"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
